// Назначение: символьный слой меркеров (%M) S7: прямые адреса и теги с адресом → переменные с AT
// Автор:      s7conv 0.1.0 (сгенерировано)
// Версия:     не указана
// Документ:   docs/MAPPING.md, раздел «Адреса»
// Адресная модель: S7 нумерует байты (%IW64 — байты 64–65, big-endian), CODESYS — слова
// (%IW32 — байты 64–65, little-endian). Адреса ниже — заготовка: на ПЛК210 каналы модулей
// привязываются в дереве устройств (I/O mapping) — сверить с конфигурацией.
{attribute 'qualified_only'}
VAR_GLOBAL
    Clock_1Hz AT %MX0.5 : BOOL; // S7 %M0.5; Меркер тактов 1 Гц (байт тактовых меркеров MB0)
    HMI_StatusPT101 AT %MW5 : WORD; // S7 %MW10; Слово состояния PT101 для старой панели
    HMI_P101Running AT %MX12.0 : BOOL; // S7 %M12.0; P101 в работе для старой панели
    HMI_DosingPacked AT %MD5 : DWORD; // S7 %MD20; Счётчики дозирования одним словом
    Tlg_Source AT %MB100 : BYTE; // S7 %MB100; Начало области данных телеграммы (P#M100.0 BYTE 16)
END_VAR
