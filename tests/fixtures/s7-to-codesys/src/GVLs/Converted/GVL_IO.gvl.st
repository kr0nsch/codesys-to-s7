    LS202_Full AT %IX0.6 : BOOL; // S7 %I0.6; Поплавок: фильтр заполнен
    P103_Fbk AT %IX0.7 : BOOL; // S7 %I0.7; P103 обратная связь контактора
    Sw_Local AT %IX1.0 : BOOL; // S7 %I1.0; Ключ «Местное» на шкафу
