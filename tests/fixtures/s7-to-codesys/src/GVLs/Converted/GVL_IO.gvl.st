    P103_ThermalOk AT %IX1.2 : BOOL; // S7 %I1.2; P103 тепловое реле в норме
    XV201_Opened AT %IX2.0 : BOOL; // S7 %I2.0; XV201 концевик «открыто»
    XV201_Closed AT %IX2.1 : BOOL; // S7 %I2.1; XV201 концевик «закрыто»
    FQ201_Pulse AT %IX3.0 : BOOL; // S7 %I3.0; Импульсы расходомера реагента (геркон НЗ)
