    Q_WashPump AT %QX0.6 : BOOL; // S7 %Q0.6; Промывной насос
    XV201_Open AT %QX1.0 : BOOL; // S7 %Q1.0; XV201 пускатель «открыть»
    XV201_Close AT %QX1.1 : BOOL; // S7 %Q1.1; XV201 пускатель «закрыть»
