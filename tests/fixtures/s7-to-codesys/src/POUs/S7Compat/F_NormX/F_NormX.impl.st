// Линейное нормирование без ограничения: вне MIN…MAX результат < 0.0 или > 1.0.
// Сравнение «больше или меньше» вместо «не равно»: проверка ширины диапазона без
// сравнения REAL на равенство.
IF rMax > rMin OR rMax < rMin THEN
    rSpan := rMax - rMin;
    F_NormX := (rValue - rMin) / rSpan;
ELSE
    // Вырожденный диапазон (в S7 — ENO = FALSE): делить на ноль нельзя, результат 0.0
    F_NormX := 0.0;
END_IF
