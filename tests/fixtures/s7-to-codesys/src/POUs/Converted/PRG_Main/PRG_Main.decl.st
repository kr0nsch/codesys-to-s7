// Автор:      не указан (исходный блок S7); перевод в ST — s7conv 0.1.0
// Версия:     0.1 (исходный блок S7)
// Документ:   docs/CONVERSION_REPORT.md, docs/MAPPING.md
// Источник:   samples/scl/OB_Main.scl, строки 41–206, ORGANIZATION_BLOCK "Main"
// Сгенерировано s7conv: пометки MIGRATION-CHECK и MIGRATION-TODO требуют ручного разбора.
// MIGRATION-CHECK: входы OB (стартовая информация S7) объявлены как VAR — CODESYS их не заполняет (стр. 45)
// MIGRATION-CHECK: вход OB Initial_Call эмулируется флагом первого цикла: флаг (не RETAIN) сбрасывается загрузкой,
//                  Reset warm/cold и перезапуском ПЛК, но не командой Stop → Start CODESYS (в S7 Initial_Call =
//                  TRUE после каждого STOP → RUN) (стр. 53)
// ---- комментарий в начале исходного файла SCL ----
// =============================================================================
// s7-to-codesys — корпус SCL. Написан с нуля, объект вымышленный (ВОС «Северная»).
//
// Файл:   OB_Main.scl
// Блок:   ORGANIZATION_BLOCK "Main" (OB1, циклическая программа)
// -----------------------------------------------------------------------------
// Назначение
//   Главный цикл станции: аналоговые входы, сигнализация, режим и группа
//   насосов, промывка фильтра, дозирование, статистика расхода, журнал,
//   старая телеграмма, слова состояния в меркерах для старой панели.
//   Номер OB1 и класс события — свойства блока, в исходник не попадают
//   (см. BlockProperties.csv).
//
// Логика (нормативное описание того, что делает OB)
//   1. Копия аварийного стопа %I0.0; PT101 (%IW64) и LT101 ("LT101_Raw")
//      через экземпляры FB_AnalogIn; прямое чтение периферии %IW272:P.
//   2. Сигнализация давления: HH или неисправность канала PT101 с задержкой
//      5 с; лампа "Lamp_Alarm" — сигнализация или нажат аварийный стоп;
//      слово аварий "DB_Plant".alarmWord побитно (.%X0...%X4).
//   3. Режим группы (FB_ModeSelect, слово команд HMI как VAR_IN_OUT), запрос
//      числом гасится после вызова. Требуемое число насосов в авто: давление
//      ниже уставки на 0,5 бар и более — 2; ниже уставки — 1; выше уставки
//      на 0,3 бар — 0; между — без изменений (держится текущее число).
//      Без аварийного стопа или не в авто — 0.
//   4. Чередование и три насоса (FB_PumpAlternation + 3 x FB_Motor), выходы
//      на контакторы — через присваивание и через "=>" в вызове.
//   5. Промывка фильтра (FB_Sequencer), поплавок через FB_Debounce, задвижка
//      подачи (FB_Valve).
//   6. Дозирование (FB_BatchCounter), счётчики в %MD20.
//   7. Раз в секунду (фронт меркера тактов "Clock_1Hz") — сдвиг выборки
//      расхода и статистика FC_Statistics, отправка старой телеграммы.
//   8. Журнал событий: код 101 — сигнализация PT101, 201...203 — аварии
//      насосов, иначе 0.
//   9. Слова состояния для старой панели: %MW10, %M12.0; счётчик жизни.
// Что проверяет при конвертации
//   OB1 -> PROGRAM + задача CODESYS; вызовы экземплярных DB ("DB_X"(...));
//   %I/%Q/%IW/%QW/%MW/%MD/%M и символьные теги "Tag" -> слой ввода-вывода (GVL с AT);
//   доступ к периферии :P; вызов FC с выходами "=>" и VAR_IN_OUT; P#-указатель
//   в параметре ANY; чтение выходов экземпляров в одном цикле.
// =============================================================================
PROGRAM PRG_Main
VAR
    Initial_Call : BOOL;  // Первый вызов OB после перехода в RUN
    Remanence : BOOL;  // TRUE, если сохраняемые данные доступны
END_VAR
VAR_TEMP
    demandPumps : INT;  // Требуемое число насосов
    shiftNow : BOOL;  // Фронт тактового меркера 1 Гц
    eventCode : INT;  // Код события для журнала
END_VAR
VAR
    xS7convFirstCycleDone : BOOL; // для эмуляции Initial_Call
END_VAR
