// Назначение: Cyclic interrupt 100 ms
// Автор:      не указан (исходный блок S7); перевод в ST — s7conv 0.1.0
// Версия:     0.1 (исходный блок S7)
// Документ:   docs/CONVERSION_REPORT.md, docs/MAPPING.md
// Источник:   samples/scl/OB_Cyclic.scl, строки 29–70, ORGANIZATION_BLOCK "Cyclic interrupt"
// Сгенерировано s7conv: пометки MIGRATION-CHECK и MIGRATION-TODO требуют ручного разбора.
// MIGRATION-CHECK: входы OB (стартовая информация S7) объявлены как VAR — CODESYS их не заполняет (стр. 33)
// MIGRATION-CHECK: вход OB Initial_Call эмулируется флагом первого цикла: флаг (не RETAIN) сбрасывается загрузкой,
//                  Reset warm/cold и перезапуском ПЛК, но не командой Stop → Start CODESYS (в S7 Initial_Call =
//                  TRUE после каждого STOP → RUN) (стр. 43)
// ---- комментарий в начале исходного файла SCL ----
// =============================================================================
// s7-to-codesys — корпус SCL. Написан с нуля, объект вымышленный (ВОС «Северная»).
//
// Файл:   OB_Cyclic.scl
// Блок:   ORGANIZATION_BLOCK "Cyclic interrupt" (OB30, период 100 мс)
// -----------------------------------------------------------------------------
// Назначение
//   Циклическое прерывание 100 мс: измерение расхода и счётчик объёма,
//   задатчик интенсивности уставки давления и ПИ-регулятор частоты ПЧ.
//   В проекте S7-300 это был OB35 с тем же периодом; при переходе на S7-1500
//   блок стал OB30. Номер, период (100 мс), сдвиг фазы и приоритет — свойства
//   блока, в исходник не попадают (см. BlockProperties.csv). Константа
//   CYCLE_TIME должна совпадать с периодом — это ручная договорённость.
//
// Логика (нормативное описание того, что делает OB)
//   1. FT101 ("FT101_Raw") через FB_AnalogIn; счётчик объёма FB_Totalizer
//      с cycleTime := CYCLE_TIME, интегрирование только при достоверном
//      расходе; объёмы копируются в "DB_Plant".
//   2. Уставка давления с HMI -> FB_Ramp -> FB_PIController; измеренное
//      давление берётся из DB_PT101, который вызывается в OB1 (значение
//      последнего цикла OB1 — риск согласованности данных между задачами).
//      Ручной режим регулятора — по команде HMI или при недостоверном PT101.
//   3. Выход регулятора 0...100 % -> 0...27648 на аналоговый выход %QW80
//      через NORM_X и SCALE_X (SCALE_X с результатом Int).
// Что проверяет при конвертации
//   циклический OB -> задача CODESYS с интервалом из свойств блока;
//   NORM_X Real->Real и SCALE_X Real->Int; данные, общие для двух задач.
// =============================================================================
PROGRAM PRG_Cyclic_interrupt
VAR
    Initial_Call : BOOL;  // Первый вызов OB (состав входов — сверить с TIA Portal)
    Event_Count : INT;  // Число потерянных запусков
END_VAR
VAR_TEMP
    speedNorm : REAL;  // Задание частоты, доли 0...1
END_VAR
VAR CONSTANT
    CYCLE_TIME : TIME := T#100MS;  // Должно совпадать со свойством OB «Время цикла»
END_VAR
VAR
    xS7convFirstCycleDone : BOOL; // для эмуляции Initial_Call
END_VAR
