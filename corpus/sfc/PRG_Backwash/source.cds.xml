    <pous>
      <pou name="PRG_Backwash" pouType="program">
        <interface>
          <inputVars>
            <variable name="xStart">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="xAbort">
              <type>
                <BOOL />
              </type>
