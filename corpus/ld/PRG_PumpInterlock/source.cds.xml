              </type>
            </variable>
          </inputVars>
          <outputVars>
            <variable name="xP1Run">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="xP2Run">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="xAnyRun">
              <type>
                <BOOL />
              </type>
            </variable>
            <variable name="xAlarm">
              <type>
                <BOOL />
              </type>
            </variable>
          </outputVars>
          <documentation>
            <xhtml xmlns="http://www.w3.org/1999/xhtml"> PRG_PumpInterlock — взаимная блокировка насосов II подъёма (LD, PROGRAM: параллели, двойная катушка).

 Поведение (модель scenarios/reference/model_PRG_PumpInterlock.py), сети по порядку:
 1. xP1Run := (xP1Ready AND NOT xP2Run) OR xP1Force;
 2. xP2Run := (xP2Ready AND NOT xP1Run) OR xP2Force — читает уже новое xP1Run этого цикла;
 3. xAnyRun := xP1Run OR xP2Run;
 4. xAlarm := xP1Run AND xP2Run;
 5. xAlarm := xEmergency — двойная катушка: последняя сеть побеждает (C2S7-GFX-DOUBLECOIL).</xhtml>
          </documentation>
        </interface>
