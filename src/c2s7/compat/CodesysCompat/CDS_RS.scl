// CodesysCompat (c2s7): RS с семантикой CODESYS Standard — сброс доминирует.
// CODESYS RS(SET, RESET1): Q1 := NOT RESET1 AND (SET OR Q1) — справка Standard.RS; проба M0 в Control Win:
// SET = RESET1 = TRUE даёт Q1 = FALSE. У S7 одноимённый RS — установка доминирует (LAD-справочник 05/2010 §1.11),
// а в SCL инструкций SR/RS нет (сравнительный список 05/2021, с. 15), поэтому — свой блок.
FUNCTION_BLOCK "CDS_RS"
TITLE = RS CODESYS (reset dominant)
{ S7_Optimized_Access := 'TRUE' }
AUTHOR : c2s7
FAMILY : CodesysCompat
VERSION : 0.1
   VAR_INPUT
      SET : Bool;   // установка
      RESET1 : Bool;   // сброс (доминирует)
   END_VAR

   VAR_OUTPUT
      Q1 : Bool;   // состояние
   END_VAR


BEGIN
	#Q1 := NOT #RESET1 AND (#SET OR #Q1);
END_FUNCTION_BLOCK
